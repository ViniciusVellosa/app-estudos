# Copie para .env (que NÃO vai para o Git) e troque os valores.
POSTGRES_DB=estudos
POSTGRES_USER=estudos
POSTGRES_PASSWORD=troque-esta-senha

# curated = só explicações escritas à mão (Mágico de Oz, sem IA). É o modo
#           das sessões de teste de usabilidade: avalia-se a interface.
# llm     = gera com IA, autoverifica (ADR 0003) e valida antes de exibir
EXPLANATION_PROVIDER=curated

# IA (só no back-end; NUNCA em variáveis VITE_, que vão embutidas no JavaScript).
# Confira o nome do modelo na documentação do provedor antes de fixar: eles mudam.
#
# Gemini (camada compatível com a OpenAI; endereço verificado em 07/11/2026):
#   LLM_BACKEND=openai_compatible
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.8-flash
#   LLM_API_KEY=  (gere em https://aistudio.google.com/apikey)
#
# Anthropic:        LLM_BACKEND=anthropic   e LLM_BASE_URL vazio
# Ollama local:     LLM_BACKEND=openai_compatible
#                   LLM_BASE_URL=http://host.docker.internal:11434/v1  (no Docker)
#                   LLM_BASE_URL=http://localhost:11434/v1             (fora do Docker)
LLM_BACKEND=openai_compatible
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Os modelos Gemini 3 raciocinam antes de responder e NÃO permitem desligar
# isso; esses tokens contam no orçamento de saída. Com 1500 a resposta sai
# cortada (finish_reason=length) e é reprovada. 8000 dá folga para os seis
# passos mais o raciocínio. O tempo também sobe: raciocinar demora.
# Quanto o modelo pode pensar antes de responder. As checagens da
# autoverificação são julgamentos curtos: raciocínio longo nelas só custa
# tempo. Vazio = não envia o parâmetro (para provedores que não o aceitam).
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=120
LLM_MAX_OUTPUT_TOKENS=8000
PROMPT_VERSION=1

# Assuntos fora da biblioteca (decisões D8 e D9). Exige EXPLANATION_PROVIDER=llm.
#   ia     = a própria IA escreve a referência, sem busca (funciona no plano gratuito)
#   gemini = pesquisa na web com Google Search; se falhar, usa "ia"
#            (no plano gratuito do Gemini a busca tem cota zero: exige faturamento)
#   vazio  = só a biblioteca de conteúdos
# Teste com: cd apps/api && uv run python -m app.smoke --pesquisa "árvore B" "one piece"
PESQUISA_PROVIDER=ia
PESQUISA_MODEL=

# Perguntas de checagem da autoverificação (1 a 6). Cada uma é uma chamada a
# mais à IA por explicação. 1 = 3 chamadas por explicação, poupa a cota.
AUTOVERIFICACAO_PERGUNTAS=1

CONSENT_VERSION=2026-1
