# Copie para .env (que NÃO vai para o Git) e troque os valores.
POSTGRES_DB=estudos
POSTGRES_USER=estudos
POSTGRES_PASSWORD=troque-esta-senha

# curated = só explicações escritas à mão (Mágico de Oz, sem IA)
# llm     = gera com IA e valida; explicações novas ficam em revisão
EXPLANATION_PROVIDER=curated
SERVE_ONLY_APPROVED=true

# IA (só no back-end; nunca em variáveis VITE_)
LLM_BACKEND=anthropic              # anthropic | openai_compatible
LLM_MODEL=                         # confira o nome atual na documentação do provedor
LLM_API_KEY=
LLM_BASE_URL=                      # ex.: http://host.docker.internal:11434/v1 para Ollama local
LLM_TIMEOUT_S=30
LLM_MAX_OUTPUT_TOKENS=1500
PROMPT_VERSION=1

CONSENT_VERSION=2026-1
